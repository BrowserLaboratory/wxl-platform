# ===========================
# Dependencies
# ===========================
node_modules/

# ===========================
# Build Output
# ===========================
dist/
.vitepress/dist/
.vitepress/cache/
.vitepress/wasm/

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.*.local
.env.development
.env.production

# ===========================
# Logs
# ===========================
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ===========================
# OS
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ===========================
# Editor & IDE
# ===========================
.idea/
.vscode/
*.swp
*.swo
*~

# ===========================
# TypeScript
# ===========================
*.tsbuildinfo

# ===========================
# Vitest / Testing
# ===========================
coverage/
.vitest-results/

# ===========================
# Rust / WASM / wasm-pack
# ===========================
target/
# wasm-pack 標準輸出目錄
pkg/
chall-wasm/*/pkg/
# 自訂 wasm-pack 輸出目錄（根目錄的隱藏資料夾）
.wasm-fs-pkg/
.wasm-asgi-pkg/
# wasm-pack 生成至 .vitepress/wasm/（含 JS bindings，已移出 public/）
platform/public/wasm/
# WASM 二進位檔（由 wasm-pack 產生）
**/*.wasm

# ===========================
# Pyodide / PHP-WASM Cache
# ===========================
pyodide-cache/
*.pyc
__pycache__/

# ===========================
# Superpowers
# ===========================
.superpowers/

# ===========================
# Misc
# ===========================
*.local
.cache/
tmp/
temp/
.worktree/

# ===========================
# Humane Prose Audit
# ===========================
# Per-file audit run output written by `audit_orchestrator.py`; the raw run dirs are not committed.
audit-runs/

# ===========================
# Claude Code scheduled tasks
# ===========================
# Runtime lock file owned by the local Claude Code session; ephemeral.
.claude/scheduled_tasks.lock

# ===========================
# wxl-crosscheck L4 blind-solve
# ===========================
# Ephemeral player-package and run.log produced by `pnpm challenge:verify --blind`.
# Deleted automatically on verify exit; never committed.
tmp/wxl-verify/

# ===========================
# Playwright
# ===========================
# Per-test failure attachments and traces created by `pnpm exec playwright test`.
test-results/
playwright-report/

# Wrangler local state (miniflare sqlite caches) — regenerated by `pnpm pages:dev`
.wrangler/

# ===========================
# fork:init (anchor mode)
# ===========================
# Each changed file's temporary sibling, written then renamed over the original (T55); a run
# interrupted before the rename can leave one behind.
*.fork-init-tmp

# 上游 skill 範例預設的 tracker 位置；本專案的 tracker 在 .proj.specs/ 與 .proj.tickets/
.scratch/

# Agent runtime 的本機設定與 worktree
.claude/settings.local.json
.claude/worktrees/
.codex/*.local.toml
.worktrees/

# ===========================
# graphify
# ===========================
# 知識圖的衍生產物與快取。唯一真相在原始碼；重建指令是 `/graphify`。
# 不進版控的決定性理由：`.graphify_python` 存的是這台機器的 uv 絕對路徑
# （/Users/<user>/.cache/uv/archive-v0/<hash>/bin/python），對其他環境是壞值，
# 而且沒有任何機制會回報它壞了。cache/ 另以工具版號為鍵，升級即整份作廢。
graphify-out/

# 交接文件，不進版控
.proj.handoffs/

# 研究筆記，不進版控
.proj.research/

# 文獻 PDF（提示詞注入 SLR），不進版控
LLM prompting SLR/
.cite-probe.env
.cite-probe-venues.yaml
# 錨定在根目錄：這條的標的是上面那批論文 PDF。沒有斜線前綴時它會匹配任何
# 層級的 references 目錄，包括 .agents/skills/*/references/ —— 那是 skill 自己
# 的內容，SKILL.md 直接引用它們，被排除的話 skill 在別台機器上就不完整。
/references/
