{
  "name": "wxl",
  "version": "3.0.0",
  "description": "Web eXploitation Laboratory — Browser-based web exploitation challenge platform powered by WASM",
  "type": "module",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrowserLaboratory/wxl-platform.git"
  },
  "bugs": {
    "url": "https://github.com/BrowserLaboratory/wxl-platform/issues"
  },
  "homepage": "https://github.com/BrowserLaboratory/wxl-platform#readme",
  "author": "CXPh03n1x",
  "license": "LicenseRef-LICENSE",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "vitest",
    "test:smoke": "playwright test --config playwright.site.config.ts",
    "test:challenges": "playwright test --config playwright.config.ts",
    "wasm:build": "wasm-pack build chall-wasm/virtual-fs --out-dir ../../.vitepress/wasm/virtual-fs --target web && wasm-pack build chall-wasm/asgi-bridge --out-dir ../../.vitepress/wasm/asgi-bridge --target web",
    "wasm:test": "cargo test --workspace",
    "wasm:tools": "cargo install wasm-tools --version 1.249.0 --locked 2>/dev/null || true",
    "dev": "pnpm wasm:build && pnpm challenge:keygen && pnpm redirects:generate && pnpm docs:dev",
    "pages:dev": "pnpm build && wrangler pages dev .vitepress/dist",
    "build": "pnpm wasm:build && pnpm challenge:keygen && pnpm redirects:generate && pnpm docs:build",
    "challenge:keygen": "node --experimental-strip-types scripts/challenge-keygen.ts",
    "create:challenge": "node --experimental-strip-types scripts/create-challenge.ts",
    "challenge:validate": "node --experimental-strip-types scripts/challenge-validate.ts",
    "redirects:generate": "node --experimental-strip-types scripts/generate-redirects.ts",
    "challenge:analyze": "node --experimental-strip-types scripts/challenge-analyze.ts",
    "fork:init": "tsx scripts/fork-init.ts",
    "challenge:retype": "tsx scripts/challenge-retype.ts",
    "challenge:verify": "tsx scripts/challenge-verify.ts",
    "challenge:verify:blind": "tsx scripts/challenge-verify-blind.ts",
    "challenge:verify:cross": "tsx scripts/challenge-verify.ts --blind --agents claude,codex,gemini",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/pre-commit.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "codemirror": "^6.0.2",
    "idb": "^8.0.3",
    "marked": "^17.0.5",
    "php-wasm": "^0.0.8",
    "pinia": "^3.0.4",
    "pyodide": "^0.29.3",
    "unocss": "^66.6.6",
    "vitepress": "2.0.0-alpha.16",
    "vue": "^3.5.30",
    "vue-i18n": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/server-renderer": "^3.5.30",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.1",
    "binaryen": "^122.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.8",
    "simple-git-hooks": "^2.13.1",
    "tsx": "4.22.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.123.0",
    "yaml": "^2.8.2"
  }
}
